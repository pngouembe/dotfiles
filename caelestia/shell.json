{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "dashboard": {
        "showWeather": true
    },
    "general": {
        "apps": {
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "lockBeforeSleep": false,
            "timeouts": [
                {
                    "timeout": 900,
                    "idleAction": "dpms off",
                    "returnAction": "dpms on"
                }
            ]
        }
    },
    "launcher": {
        "actionPrefix": ">"
    },
    "session": {
        "commands": {
            "logout": [
                "uwsm",
                "stop"
            ]
        }
    },
    "services": {
        "weatherUnits": "Celsius",
        "sensorUnits": "Celsius",
        "clockFormat": "TwentyFourHour"
    }
}
