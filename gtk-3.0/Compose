# us(intl): make ' + c give ç rather than ć. GTK's built-in input method
# ignores XCOMPOSEFILE (set in hypr/hyprland.lua for xkbcommon apps) and reads
# this file instead. GTK 3's parser skips `include` lines (GTK 4 supports
# them, see gtk-4.0/Compose), so the sequences are spelled out here.
<dead_acute> <c>	: "ç"	ccedilla
<dead_acute> <C>	: "Ç"	Ccedilla
