# Stow ignore file — patterns are Perl regex, anchored.
# Patterns without `/` match basenames at any depth.
# Patterns with `/` match paths relative to the package root.

# VCS and stow metadata
\.git
\.stowrc
\.stow-local-ignore

# Project-local Claude Code settings. Belongs to this repo as a working
# directory, not to ~/.config — the real user config lives in ~/.claude.
^/\.claude

# Repo docs and install plumbing (not config)
^/README\.md
^/justfile
^/bootstrap\.sh
^/scripts
^/keyboard_layout
^/\.docker

# Nix flake and modules (system config, not stowed)
^/flake\.nix
^/flake\.lock
^/nix

# Login greeter config: installed into /etc/greetd by scripts/setup-greeter.sh,
# not linked into ~/.config.
^/greetd

# Editor leftovers
.+\.swp$
.+\.bak$
