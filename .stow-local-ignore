# Stow ignore file — patterns are Perl regex, anchored.
# Patterns without `/` match basenames at any depth.
# Patterns with `/` match paths relative to the package root.

# VCS and stow metadata
\.git
\.gitignore
\.stowrc
\.stow-local-ignore

# Project-local Claude Code settings. Belongs to this repo as a working
# directory, not to ~/.config — the real user config lives in ~/.claude.
^/\.claude

# Repo docs and install plumbing (not config)
^/README\.md
^/docs
^/justfile
^/bootstrap\.sh
^/scripts
^/keyboard_layout
^/\.docker

# Nix flake and modules (system config, not stowed)
^/flake\.nix
^/flake\.lock
^/nix

# Login greeter config: installed into /etc/greetd by scripts/setup-greeter.sh,
# not linked into ~/.config.
^/greetd

# SDDM config: installed into /etc/sddm.conf.d by scripts/setup-sddm.sh.
^/sddm

# RAW thumbnailer: installed into /usr/local by scripts/setup-raw-thumbnails.sh
# (the thumbnailer sandbox can't see $HOME).
^/thumbnailers

# Zed saves by writing a temp file and renaming it over the target, which
# replaces a per-file symlink with a real file. `just link-zed` links the whole
# directory instead (stow can't, because of --no-folding), so saves land in the repo.
^/zed

# Editor leftovers
.+\.swp$
.+\.bak$
